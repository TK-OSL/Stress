        let currentLang = 'en';

        // ฟังก์ชันสำหรับเปลี่ยนภาษาของหน้าเว็บ
        function setLanguage(lang) {
            currentLang = lang;
            
            // Toggle Buttons (สลับสถานะปุ่มเมนูภาษา)
            document.getElementById('btn-en').classList.remove('active');
            document.getElementById('btn-th').classList.remove('active');
            document.getElementById(`btn-${lang}`).classList.add('active');

            // Static Text
            const texts = i18n[lang];
            for (const key in texts) {
                const element = document.getElementById(key);
                if (element) element.innerHTML = texts[key];
            }

            // Complex list items formatting (Preserving structural tags)
            if (lang === 'en') {
                document.getElementById('tensile-title').nextSibling.nodeValue = ' Occurs when a pulling force attempts to stretch the object. ';
                document.getElementById('tensile-title').nextElementSibling.innerHTML = '(Force acts perpendicular to the surface)';
                
                document.getElementById('compressive-title').nextSibling.nodeValue = ' Occurs when a pushing force attempts to shorten the object. ';
                document.getElementById('compressive-title').nextElementSibling.innerHTML = '(Force acts perpendicular to the surface)';
                
                document.getElementById('shear-title').nextSibling.nodeValue = ' Occurs when forces act parallel to the cross-sectional area, causing the material to slide against itself. ';
                document.getElementById('shear-title').nextElementSibling.innerHTML = '(Force acts parallel to the surface)';
            } else {
                document.getElementById('tensile-title').nextSibling.nodeValue = ' เกิดขึ้นเมื่อมีแรงดึงพยายามทำให้วัตถุยืดออก ';
                document.getElementById('tensile-title').nextElementSibling.innerHTML = '(ทิศทางแรงทำมุมตั้งฉากกับผิวสัมผัส)';
                
                document.getElementById('compressive-title').nextSibling.nodeValue = ' เกิดขึ้นเมื่อมีแรงกดพยายามทำให้วัตถุหดสั้นลง ';
                document.getElementById('compressive-title').nextElementSibling.innerHTML = '(ทิศทางแรงทำมุมตั้งฉากกับผิวสัมผัส)';
                
                document.getElementById('shear-title').nextSibling.nodeValue = ' เกิดขึ้นเมื่อมีแรงกระทำขนานกับพื้นที่หน้าตัด ทำให้เนื้อวัสดุพยายามเลื่อนไถลออกจากกัน ';
                document.getElementById('shear-title').nextElementSibling.innerHTML = '(ทิศทางแรงทำมุมขนานกับผิวสัมผัส)';
            }

            updateExamples();
        }

        // --- 3D Rotation Logic ---
        // ระบบควบคุมการหมุนโมเดล 3 มิติ (ใช้ทั้งเมาส์และจอสัมผัส)
        const rotator = document.getElementById('rotator');
        const sceneContainer = document.getElementById('sceneContainer');
        const dragHint = document.getElementById('drag-hint');
        
        let rotX = -20;
        let rotY = -45;
        let isDragging = false;
        let startMouseX, startMouseY;
        let startRotX, startRotY;

        function updateRotation() {
            rotator.style.transform = `translateZ(-75px) rotateX(${rotX}deg) rotateY(${rotY}deg)`;
        }

        function setView(x, y) {
            rotX = x;
            rotY = y;
            rotator.style.transition = 'transform 0.6s cubic-bezier(0.4, 0, 0.2, 1)';
            updateRotation();
        }

        function getEventPos(e) {
            return e.touches ? { x: e.touches[0].clientX, y: e.touches[0].clientY } : { x: e.clientX, y: e.clientY };
        }

        function handleDragStart(e) {
            isDragging = true;
            const pos = getEventPos(e);
            startMouseX = pos.x;
            startMouseY = pos.y;
            startRotX = rotX;
            startRotY = rotY;
            rotator.style.transition = 'none'; // Disable transition for smooth dragging
            dragHint.style.opacity = '0'; // Hide hint when interacting
        }

        function handleDragMove(e) {
            if (!isDragging) return;
            e.preventDefault(); // Prevent scrolling while rotating
            const pos = getEventPos(e);
            const deltaX = pos.x - startMouseX;
            const deltaY = pos.y - startMouseY;
            
            // Adjust sensitivity
            rotY = startRotY + deltaX * 0.5;
            rotX = startRotX - deltaY * 0.5; 
            
            // Limit X rotation to prevent flipping upside down confusingly if desired
            if (rotX > 90) rotX = 90;
            if (rotX < -90) rotX = -90;

            updateRotation();
        }

        function handleDragEnd() {
            isDragging = false;
            rotator.style.transition = 'transform 0.4s ease-out'; // เปิด transition กลับเพื่อให้ปล่อยแล้วค่อยๆ หยุด
        }

        // Event Listeners สำหรับเมาส์
        sceneContainer.addEventListener('mousedown', handleDragStart);
        window.addEventListener('mousemove', handleDragMove);
        window.addEventListener('mouseup', handleDragEnd);

        // Event Listeners สำหรับจอสัมผัส (มือถือ/แท็บเล็ต)
        sceneContainer.addEventListener('touchstart', handleDragStart, {passive: false});
        window.addEventListener('touchmove', handleDragMove, {passive: false});
        window.addEventListener('touchend', handleDragEnd);

        // --- 3D Animation & Forces Logic ---
        // ระบบควบคุมแอนิเมชันการเสียรูป (Deformation) และเวกเตอร์แรง (Force Vectors)
        const cube = document.getElementById('materialCube');
        const arrowTop = document.getElementById('arrow-top');
        const arrowBottom = document.getElementById('arrow-bottom');

        function applyForce(type) {
            // Reset states (เคลียร์สถานะทั้งหมดเพื่อเตรียมเล่นแอนิเมชันใหม่)
            arrowTop.className = 'force-arrow arrow-top';
            arrowBottom.className = 'force-arrow arrow-bottom';
            cube.style.transform = 'scaleY(1) scaleX(1) scaleZ(1) skewX(0deg)';
            changeColor('rgba(59, 130, 246, 0.7)', '#1d4ed8'); // รีเซ็ตสีกลับเป็นสีน้ำเงิน

            // ใช้ setTimeout เล็กน้อยเพื่อให้คลาสเก่าถูกลบออกสนิท ก่อนใส่คลาสใหม่ (เล่นซ้ำได้)
            setTimeout(() => {
                if (type === 'tension') {
                    // แรงดึง: ยืดตัวตามแกน Y และหดเข้าตามแกน X, Z (คุณสมบัติ Poisson's ratio)
                    cube.style.transform = 'scaleY(1.5) scaleX(0.85) scaleZ(0.85)';
                    changeColor('rgba(239, 68, 68, 0.7)', '#b91c1c');
                    // กระตุ้น Animation ของลูกศร
                    arrowTop.classList.add('tension');
                    arrowBottom.classList.add('tension');

                } else if (type === 'compression') {
                    // แรงอัด: หดตัวตามแกน Y และบวมออกตามแกน X, Z
                    cube.style.transform = 'scaleY(0.5) scaleX(1.15) scaleZ(1.15)';
                    changeColor('rgba(16, 185, 129, 0.7)', '#047857');
                    arrowTop.classList.add('compression');
                    arrowBottom.classList.add('compression');

                } else if (type === 'shear') {
                    // แรงเฉือน: บิดเบี้ยว (Skew) ไปตามแรงที่กระทำขนานกับผิวสัมผัส
                    cube.style.transform = 'skewX(15deg)';
                    changeColor('rgba(245, 158, 11, 0.7)', '#d97706');
                    arrowTop.classList.add('shear');
                    arrowBottom.classList.add('shear');
                }
            }, 50);
        }

        // ฟังก์ชันช่วยเปลี่ยนสีชิ้นส่วนด้านข้างของกล่อง 3 มิติทุกด้าน
        function changeColor(bgColor, borderColor) {
            const faces = document.querySelectorAll('.face');
            faces.forEach(face => {
                face.style.backgroundColor = bgColor;
                face.style.borderColor = borderColor;
            });
        }

        // --- Editable Examples Logic ---
        // ระบบจัดการโจทย์ปัญหาที่ผู้ใช้สามารถแก้ไขตัวเลข และระบบเฉลยตามแบบ Real-time
        
        // สร้าง HTML รูปแบบเศษส่วน (ตัวเศษส่วนตัวส่วน)
        function getFractionHTML(num, den) {
            return `<span class="fraction"><span class="numerator">${num}</span><span class="denominator">${den}</span></span>`;
        }

        // อ่านค่าจาก Input กล่องไข่ปลา และคำนวณเฉลย
        function updateExamples() {
            // Example 1
            const ex1A = parseFloat(document.getElementById('ex1-a').value) || 0;
            const ex1F = parseFloat(document.getElementById('ex1-f').value) || 0;
            const steps1 = document.getElementById('ex1-steps');
            const ans1 = document.getElementById('ex1-ans');

            if (ex1A <= 0) {
                ans1.innerHTML = currentLang === 'en' ? "Area must be greater than 0." : "พื้นที่หน้าตัดต้องมากกว่า 0";
                ans1.style.color = 'red';
                ans1.style.backgroundColor = '#fee2e2';
                ans1.style.borderColor = '#fca5a5';
                steps1.innerHTML = '';
            } else {
                const stress1 = ex1F / ex1A;
                const stress1Formatted = stress1.toLocaleString('en-US', { maximumFractionDigits: 2 });
                ans1.style.color = '#166534';
                ans1.style.backgroundColor = '#dcfce7';
                ans1.style.borderColor = '#bbf7d0';

                if (currentLang === 'en') {
                    steps1.innerHTML = `
                        <li><strong>Analyze:</strong> F = ${ex1F.toLocaleString()} N, A = ${ex1A} m&sup2;</li>
                        <li><strong>Formula:</strong> &sigma; = ${getFractionHTML('F', 'A')}</li>
                        <li><strong>Substitute:</strong> &sigma; = ${getFractionHTML(ex1F.toLocaleString(), ex1A)}</li>
                        <li><strong>Calculate:</strong> &sigma; = ${stress1Formatted} N/m&sup2;</li>
                    `;
                    ans1.innerHTML = `<strong>Answer:</strong> The tensile stress is <strong>${stress1Formatted} Pascals (Pa)</strong>.`;
                } else {
                    steps1.innerHTML = `
                        <li><strong>วิเคราะห์โจทย์:</strong> ทราบค่า F = ${ex1F.toLocaleString()} N และ A = ${ex1A} m&sup2;</li>
                        <li><strong>จากสูตร:</strong> &sigma; = ${getFractionHTML('F', 'A')}</li>
                        <li><strong>แทนค่า:</strong> &sigma; = ${getFractionHTML(ex1F.toLocaleString(), ex1A)}</li>
                        <li><strong>ผลลัพธ์:</strong> &sigma; = ${stress1Formatted} N/m&sup2;</li>
                    `;
                    ans1.innerHTML = `<strong>ตอบ:</strong> ความเค้นดึงมีค่าเท่ากับ <strong>${stress1Formatted} พาสคัล (Pa)</strong>`;
                }
            }

            // Example 2
            const ex2W = parseFloat(document.getElementById('ex2-w').value) || 0;
            const ex2F = parseFloat(document.getElementById('ex2-f').value) || 0;
            const steps2 = document.getElementById('ex2-steps');
            const ans2 = document.getElementById('ex2-ans');

            if (ex2W <= 0) {
                ans2.innerHTML = currentLang === 'en' ? "Width must be greater than 0." : "ความกว้างต้องมากกว่า 0";
                ans2.style.color = 'red';
                ans2.style.backgroundColor = '#fee2e2';
                ans2.style.borderColor = '#fca5a5';
                steps2.innerHTML = '';
            } else {
                const ex2A = ex2W * ex2W;
                const stress2 = ex2F / ex2A;
                const stress2Formatted = stress2.toLocaleString('en-US', { maximumFractionDigits: 2 });
                ans2.style.color = '#166534';
                ans2.style.backgroundColor = '#dcfce7';
                ans2.style.borderColor = '#bbf7d0';

                if (currentLang === 'en') {
                    steps2.innerHTML = `
                        <li><strong>Analyze:</strong> F = ${ex2F.toLocaleString()} N. Area (A) is unknown.</li>
                        <li><strong>Find Area (A) of square:</strong> A = width &times; length = ${ex2W} &times; ${ex2W} = ${ex2A.toFixed(4)} m&sup2;</li>
                        <li><strong>Formula:</strong> &sigma; = ${getFractionHTML('F', 'A')}</li>
                        <li><strong>Substitute:</strong> &sigma; = ${getFractionHTML(ex2F.toLocaleString(), ex2A.toFixed(4))}</li>
                        <li><strong>Calculate:</strong> &sigma; = ${stress2Formatted} N/m&sup2;</li>
                    `;
                    ans2.innerHTML = `<strong>Answer:</strong> The compressive stress is <strong>${stress2Formatted} Pascals (Pa)</strong>.`;
                } else {
                    steps2.innerHTML = `
                        <li><strong>วิเคราะห์โจทย์:</strong> ทราบค่า F = ${ex2F.toLocaleString()} N แต่ยังไม่ทราบพื้นที่ A</li>
                        <li><strong>หาพื้นที่หน้าตัด (A) ของเสาสี่เหลี่ยมจัตุรัส:</strong> A = กว้าง &times; ยาว = ${ex2W} &times; ${ex2W} = ${ex2A.toFixed(4)} m&sup2;</li>
                        <li><strong>จากสูตร:</strong> &sigma; = ${getFractionHTML('F', 'A')}</li>
                        <li><strong>แทนค่า:</strong> &sigma; = ${getFractionHTML(ex2F.toLocaleString(), ex2A.toFixed(4))}</li>
                        <li><strong>ผลลัพธ์:</strong> &sigma; = ${stress2Formatted} N/m&sup2;</li>
                    `;
                    ans2.innerHTML = `<strong>ตอบ:</strong> ความเค้นอัดที่เกิดขึ้นมีค่า <strong>${stress2Formatted} พาสคัล (Pa)</strong>`;
                }
            }
        }

        // Init (คำสั่งเริ่มต้นทำงานเมื่อเว็บโหลดเสร็จ)
        window.onload = () => {
            setLanguage('en'); // เลือกใช้ภาษาอังกฤษเป็นค่าเริ่มต้น
            updateExamples();  // สั่งให้คำนวณเฉลยทันทีด้วยค่าตัวเลขตั้งต้น
        };
    </script>
